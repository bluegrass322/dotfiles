[alias]
  # add
  patch = add --patch
  unstage = reset HEAD

  # branch
  branches = branch --sort=-committerdate
  copy-branch = ! git branch --contains | cut -d ' ' -f 2 | pbcopy
  delete-branch = branch -d
  rename-branch = branch -m
  show-parent = ! git show-branch | grep '*' | grep -v "$(git rev-parse --abbrev-ref HEAD)" | head -1 | awk -F'[]~^[]' '{print $2}'

  # checkout
  discard = checkout --
  burn-up = !git checkout . HEAD && git clean -d -f

  # cherry-pick
  pick = cherry-pick --edit

  # commit
  uncommit = reset --soft HEAD^

  # diff
  difff = diff --word-diff

  # log
  log = log --pretty=format:'%Cgreen%cd  %Cred%h%Creset  %s' --date=format:'%Y%m%d %H:%M'
  last = log -1 HEAD

  # squash
  squash = rebase --interactive HEAD~
  unsquash = reset --hard

  # stash
  save = stash push --staged --message
  saves = stash list
  load = stash pop
  delete-save = stash drop
  peek = stash show --include-untracked --patch

  # status
  changes = status -s

  # switch
  new-branch = switch -c
  switch-main = ! git switch main && git pull origin main
  switch-shelter = switch -c do-something

  # worktree
  deliquesce = worktree add -b

[core]
  editor = nvim
  hooksPath = ~/dotfiles/git/hooks

[include]
  path = ~/dotfiles/gitconfig.local

[credential]
  helper = store
