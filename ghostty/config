background-opacity = 0.8
background-blur = true

font-family = Intel One Mono
font-family = IBM Plex Sans JP

font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-thicken = true

theme = mayuzumi

cursor-style = block_hollow
cursor-style-blink = true

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify

window-save-state = always

keybind = ctrl+c>ctrl+m=toggle_command_palette
keybind = cmd+r=reload_config

keybind = ctrl+w>ctrl+k=goto_split:top
keybind = ctrl+w>ctrl+j=goto_split:bottom
keybind = ctrl+w>ctrl+l=goto_split:right
keybind = ctrl+w>ctrl+h=goto_split:left

keybind = option+backspace=text:\x1b\x7f
keybind = shift+enter=text:\x1b\r

config-file = ?config.local

